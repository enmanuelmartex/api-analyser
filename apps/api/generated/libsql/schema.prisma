model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  password      String?
  role          Role      @default(ADMIN)
  avatar        String?
  isActive      Boolean   @default(true)
  lastLogin     DateTime?
  emailVerified Boolean   @default(false)
  ownerId       String?

  /// Display preferences, all nullable, and null is a meaning rather than a gap:
  /// "this account has not chosen, so fall back to the product default".
  ///
  /// Stored as plain strings rather than enums on purpose. The set of date
  /// formats and avatar colours is a presentation catalogue owned by the web
  /// app — adding "14 Aug 2026" to the list should not require a database
  /// migration, and a value the browser no longer recognises degrades to the
  /// default instead of failing. The API still validates every value against a
  /// known set at the boundary (see `auth/display-preferences.ts`), so a typo
  /// is rejected at write time rather than discovered at read time.
  ///
  /// `timeZone` is the exception: it is an IANA name and is validated against
  /// the runtime's own tz database, exactly as scheduled scans are.
  avatarColor String?
  timeZone    String?
  dateFormat  String?
  timeFormat  String?

  /// Light/dark preference — `system`, `light` or `dark`.
  ///
  /// ADDED FOR EMAIL, and that is the whole reason it is a column rather than
  /// staying in the browser. `next-themes` keeps the choice in `localStorage`,
  /// which is exactly the right place for a preference only the browser acts
  /// on — but the transactional emails are rendered in a Vercel function that
  /// has no access to it, and an email cannot ask. Persisting it here is what
  /// lets the server resolve which variant of a message to send.
  ///
  /// Null means "never chosen", and resolves to the product default the same
  /// way every other preference here does. `system` is stored verbatim rather
  /// than resolved at write time, because what the OS reports can change after
  /// the user sets it; the email pipeline resolves `system` to `light` at send
  /// time, since a server has no way to observe an OS theme.
  theme String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner                  User?                   @relation("OwnerMembers", fields: [ownerId], references: [id])
  members                User[]                  @relation("OwnerMembers")
  sessions               Session[]
  accounts               Account[]
  projects               Project[]
  apiKeys                ApiKey[]
  auditLogs              AuditLog[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  pluginUserConfigs      PluginUserConfig[]
  scanProfiles           ScanProfile[]
  assignedIssues         SecurityIssue[]         @relation("IssueAssignee")
  issueStatusChanges     IssueStatusChange[]     @relation("IssueStatusActor")
  scheduledScans         ScheduledScan[]         @relation("ScheduleAuthor")
  requestedReports       Report[]                @relation("ReportRequester")
  emailDeliveries        EmailDelivery[]

  @@map("users")
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique
  keyPreview String
  lastUsedAt DateTime?
  expiresAt  DateTime?
  isActive   Boolean   @default(true)
  /// Was `String[] @default(["read", "write"])`. The default is preserved
  /// verbatim through the JSON conversion so this commit changes no behaviour.
  /// It is worth revisiting when programmatic access actually ships: a scope
  /// list that defaults to read+write grants permissions nobody asked for, and
  /// the read path in `common/db/json-list.ts` already fails closed. Nothing in
  /// the application reads or writes this table today.
  scopes     Json      @default("[\"read\", \"write\"]")

  createdAt DateTime @default(now())

  @@map("api_keys")
}

