enum AssessmentStatus {
  PENDING
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

/// What caused an assessment to exist.
///
/// A scheduled scan produces an ORDINARY assessment — same model, same worker,
/// same findings — and this column is the only thing that distinguishes it. It
/// exists so the UI can say "triggered by Weekly Production Scan" rather than
/// implying a person pressed a button, and so automated runs can be excluded
/// from "what did this operator do?" reviews.
enum AssessmentTrigger {
  MANUAL
  SCHEDULED
}

/// The recurrence family of a scheduled scan.
///
/// CUSTOM is the escape hatch: it carries a validated 5-field cron expression
/// evaluated in the schedule's own timezone. The other five are structured
/// fields, so the common cases never require an operator to write cron.
enum ScheduleFrequency {
  ONCE
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

/// The DURABLE intent of a schedule — deliberately not its live activity.
///
/// "Running" and "Failed" are properties of the most recent execution, not of
/// the schedule, and persisting them here would be a bug waiting to happen: a
/// worker killed mid-scan would leave a schedule stuck at RUNNING forever with
/// nothing to reset it. The API derives a display status from these three plus
/// the latest execution instead (see ScheduledScansService.toResponse).
enum ScheduleStatus {
  ACTIVE
  PAUSED
  /// A ONCE schedule whose single occurrence has already been dispatched.
  COMPLETED
}

/// Outcome of one attempt to honour a schedule occurrence.
///
/// SKIPPED is the one that matters most: it records that the occurrence was
/// reached and deliberately not run (the previous scan was still going), which
/// is otherwise indistinguishable from the scheduler having failed to fire.
enum ScheduleExecutionStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  SKIPPED
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

/// Triage state of a persistent SecurityIssue.
///
/// The state belongs to the issue, not to any single detection: it survives
/// rescans and the deletion of the scan that first produced it.
enum IssueStatus {
  /// Detected and not yet triaged.
  OPEN
  /// A human has reviewed it and accepts it is real; remediation is pending.
  ACKNOWLEDGED
  /// Believed fixed. A later detection reopens it (see reopenCount).
  RESOLVED
  /// Real, but accepted as a business decision. Still counts as technical risk.
  ACCEPTED_RISK
  /// Judged not a real vulnerability. Never auto-reopened.
  FALSE_POSITIVE
}

/// Whether a single detection has been manually verified.
///
/// Distinct from IssueStatus: this records confidence in one observation,
/// not the triage decision for the underlying vulnerability.
enum OccurrenceValidation {
  UNVERIFIED
  VERIFIED
  REFUTED
}

/// Trustworthiness of a computed assessment score.
///
/// Prevents an incomplete run from being presented as a real result — the
/// defect where a failed scan displayed a perfect 100.
enum ScoreStatus {
  /// No score can be computed: queued, running, failed, cancelled, or no check
  /// completed successfully. `securityScore` MUST be null.
  UNAVAILABLE
  /// Computed, but some planned checks failed or were skipped, so the score
  /// reflects partial coverage. Must be labelled as provisional in the UI.
  PROVISIONAL
  /// Every planned check executed successfully. Only a FINAL score with zero
  /// findings may legitimately show 100.
  FINAL
}

/// Business importance of the API a project represents.
///
/// Deliberately separate from Environment: a staging system can be critical,
/// and a production system can be low-value.
enum AssetCriticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReportType {
  EXECUTIVE
  TECHNICAL
  COMPLIANCE
  DEVELOPER
}

enum ReportFormat {
  PDF
  HTML
  MARKDOWN
  JSON
  SARIF
}

/// Why a report exists, which decides who is allowed to create it and whether
/// its absence is a bug.
///
/// `AUTOMATIC_SCAN_REPORT` is the one the system owes the user for every
/// completed scan — exactly one per assessment, enforced by `autoKey` below.
/// The other two are produced on request and may exist many times over.
enum ReportKind {
  AUTOMATIC_SCAN_REPORT
  MANUAL_EXPORT
  SCHEDULED_REPORT
}

/// Where a report is in its generation lifecycle.
///
/// Defaulted to COMPLETED so every row that existed before asynchronous
/// generation — all of which were written synchronously and already have their
/// bytes — keeps describing itself accurately instead of appearing stuck in
/// PENDING forever.
enum ReportStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
}

/// Outcome of one attempted email delivery.
///
/// SKIPPED is a first-class result, not a failure: a user with email
/// notifications switched off, or with no address, produces a SKIPPED row so
/// "why did I not get an email" is answerable from the record.
enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
  SCAN_START
  SCAN_STOP
  ROLE_CHANGE
  PASSWORD_RESET
}

/// How much a reader should care about one event.
///
/// Deliberately the syslog-shaped set every operator already knows, rather than
/// a product-specific vocabulary. `Severity` (CRITICAL…INFO) already exists in
/// this schema and means something entirely different — the risk of a
/// *vulnerability* — so this one is named for logs and must never be conflated
/// with it.
enum LogSeverity {
  DEBUG
  INFO
  WARNING
  ERROR
  CRITICAL
}

/// The subsystem an event came from. Drives the category filter and decides
/// which events survive `logCollectionEnabled = false` (see AuditService).
enum LogCategory {
  AUTHENTICATION
  USERS
  PROJECTS
  SCANS
  FINDINGS
  REPORTS
  CONFIGURATION
  SECURITY
  SYSTEM
  API
  WORKER
  DATABASE
  NOTIFICATIONS
}

/// Outcome of the attempt the event describes.
///
/// Separate from severity: a WARNING-severity event can still have succeeded,
/// and a failed request is not automatically an ERROR to an operator.
enum LogStatus {
  SUCCESS
  FAILED
  WARNING
}

/// What kind of thing happened, for notification routing and iconography.
///
/// Adding a value here is half the work: the other half is one entry in
/// `notification-catalog.ts`, which is the single place that decides the
/// category, the severity, the preference switch and whether the type may be
/// emailed. Nothing else in the application branches on this enum.
enum NotificationType {
  SCAN_COMPLETED
  SCAN_FAILED
  REPORT_GENERATED
  REPORT_FAILED
  SECURITY_WARNING
  CRITICAL_FINDING
  NEW_FINDINGS
  SCHEDULED_SCAN_COMPLETED
  SCHEDULED_SCAN_FAILED
  EMAIL_REPORT_SENT
  EMAIL_REPORT_FAILED
  SYSTEM_ERROR
}

/// Which product area a notification belongs to. Groups the preference
/// switches and drives the per-section unread counters in the sidebar.
///
/// ISSUES is separate from SECURITY on purpose: ISSUES means "this scan found
/// vulnerabilities in your API" and badges the Issues screen, while SECURITY
