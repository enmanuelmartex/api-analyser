model Assessment {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  status      AssessmentStatus @default(PENDING)
  progress    Int              @default(0) // 0-100
  currentStep String?
  jobId       String? // BullMQ job ID

  /// How this run came to exist. Every pre-existing row is MANUAL, which is
  /// true: scheduling did not exist when they were written.
  trigger    AssessmentTrigger @default(MANUAL)
  /// The schedule that produced it, when `trigger` is SCHEDULED.
  ///
  /// SetNull, never Cascade. Deleting a schedule must not erase the scans it
  /// produced, nor the findings and reports hanging off them — the same rule
  /// that governs IssueStatusChange.assessmentId.
  scheduleId String?
  schedule   ScheduledScan?    @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  config  AssessmentConfig?
  summary AssessmentSummary?

  startedAt   DateTime?
  completedAt DateTime?
  duration    Int? // seconds

  occurrences        FindingOccurrence[]
  /// Triage transitions this scan caused. SetNull on the far side, so deleting
  /// the scan detaches the history rather than deleting it.
  issueStatusChanges IssueStatusChange[]
  reports            Report[]
  logs               AssessmentLog[]
  pluginExecutions   PluginExecution[]
  scheduleExecutions ScheduleExecution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Scan history for one project, newest first (project detail → Scans tab).
  @@index([projectId, createdAt])
  /// "Running / failed scans needing attention" on the dashboard.
  @@index([projectId, status])
  /// Global scans list filtered by status across all projects.
  @@index([status, createdAt])
  /// The skipIfRunning guard: "is a scan from this schedule still in flight?"
  @@index([scheduleId, status])
  @@map("assessments")
}

// =============================================================================
// SCHEDULED SCANS
//
// A scheduled scan owns WHEN and WITH WHAT, and nothing else. It does not scan.
// When an occurrence comes due the scheduler calls the very same entry point the
// "Run Assessment" button calls (AssessmentsService.createAndRun), so there is
// exactly one scan pipeline and a scheduled run is an ordinary Assessment that
// happens to carry `trigger = SCHEDULED`.
//
//   ScheduledScan     — the recurrence rule and the frozen scan configuration.
//   ScheduleExecution — one attempt to honour one occurrence. Immutable identity
//                       (scheduleId + scheduledFor), which is the duplicate guard.
// =============================================================================

/// A recurring (or one-off) automatic scan of one project.
model ScheduledScan {
  id        String  @id @default(cuid())
  name      String
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Who set it up. SetNull so removing an operator does not delete the
  /// automation they left behind — the schedule keeps running, and the audit
  /// trail still records who created it.
  createdById String?
  createdBy   User?   @relation("ScheduleAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  // ── Recurrence ─────────────────────────────────────────────────────────────
  frequency ScheduleFrequency

  /// IANA zone, e.g. `America/Santo_Domingo`. Never a fixed offset: an offset
  /// cannot express "02:00 local, before and after the DST change", which is
  /// exactly what an operator means by "every day at 2am".
  timezone String @default("UTC")

  /// Wall-clock time of day in `timezone`, for DAILY / WEEKLY / MONTHLY and as
  /// the anchor of an HOURLY interval. Null for CUSTOM, which gets its times
  /// from the cron expression.
  hour   Int?
  minute Int?

  /// HOURLY: hours between runs. Ignored by every other frequency.
  intervalHours Int?

  /// WEEKLY: ISO-ish day numbers, 0 = Sunday … 6 = Saturday, in `timezone`.
  weekdays Json @default("[]")

  /// MONTHLY: 1–31. A month shorter than the chosen day runs on its last day
  /// (clamped, never skipped) — "day 31 of every month" means "month end".
  monthDay Int?

  /// CUSTOM: validated 5-field cron (`min hour dom mon dow`), evaluated in
  /// `timezone`. Rejected if it would fire more often than once every 15
  /// minutes — see assertSafeCron.
  cronExpression String?

  /// ONCE: the single instant to run at, stored in UTC.
  /// Other frequencies: an optional "not before" bound, so a weekly schedule
  /// can be created today to start next month.
  startAt DateTime?

  // ── Scan configuration ─────────────────────────────────────────────────────
  // Mirrors AssessmentConfig field for field, because it is copied onto the
  // AssessmentConfig of every run this schedule produces. Deliberately a copy
  // rather than a pointer: editing a schedule must not rewrite the recorded
  // configuration of scans that already ran.
  //
  // NOTE what is absent: no token, no API key, no header. Target credentials
  // live encrypted on AuthConfig and are read by the worker at the point of
  // use; copying them here would put a second plaintext-adjacent copy of every
  // secret in a table an operator lists in the UI.
  executionMode          String       @default("all") // "all" | "profile" | "manual"
  scanProfileId          String?
  scanProfile            ScanProfile? @relation(fields: [scanProfileId], references: [id], onDelete: SetNull)
  manualPlugins          Json         @default("[]")
  enableAiAnalysis       Boolean      @default(true)
  maxRequestsPerEndpoint Int          @default(10)
  requestDelayMs         Int          @default(200)
  timeoutMs              Int          @default(10000)

  // ── State ──────────────────────────────────────────────────────────────────
  status ScheduleStatus @default(ACTIVE)

  /// Do not start a run while the previous run from THIS schedule is still
  /// going. On by default: an hourly scan of a slow API would otherwise stack
  /// runs against the same target until something falls over.
  skipIfRunning Boolean @default(true)

  /// The next occurrence, in UTC. Null when PAUSED or COMPLETED.
  ///
  /// Also the concurrency primitive: dispatch claims an occurrence with a
  /// conditional update on this exact value, so two API instances racing on the
  /// same schedule produce one winner and one no-op. See claimOccurrence.
  nextRunAt DateTime?
  lastRunAt DateTime?

  /// Rolling counters, for the list view and for spotting a schedule that has
  /// been failing unattended. A failure never pauses the schedule.
  totalRuns           Int @default(0)
  consecutiveFailures Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  executions  ScheduleExecution[]
  assessments Assessment[]

  /// The scheduler's hot path: "which schedules are due?", every tick.
  @@index([status, nextRunAt])
  /// Schedules of one project (project detail → Scheduled scans).
  @@index([projectId])
  @@map("scheduled_scans")
}

/// One attempt to honour one occurrence of a schedule.
///
/// A row exists whatever happened — dispatched, skipped, or failed to start —
/// so "why did my 02:00 scan not run?" is always answerable from the table
/// rather than inferred from the absence of an assessment.
model ScheduleExecution {
  id         String        @id @default(cuid())
  scheduleId String
  schedule   ScheduledScan @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  /// The assessment this execution started. Null for SKIPPED executions and for
  /// a dispatch that failed before an assessment could be created.
  ///
  /// SetNull: deleting a scan leaves the execution as evidence that it ran.
  assessmentId String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  status ScheduleExecutionStatus @default(QUEUED)

  /// The occurrence this execution belongs to — the planned instant, not the
  /// moment work began. Late dispatch after an outage keeps the planned value,
  /// which is what makes the lateness visible.
  scheduledFor DateTime
  startedAt    DateTime?
  finishedAt   DateTime?

  /// MANUAL for "Run now", SCHEDULED for the scheduler. A manual run is
  /// recorded here too, but never advances `nextRunAt`.
  trigger AssessmentTrigger @default(SCHEDULED)

  /// Why a SKIPPED execution was skipped, or why a dispatch failed. Free text,
  /// sanitised like any other operator-visible message.
  reason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// THE duplicate guard, and the reason multiple API instances are safe.
  ///
  /// `scheduledFor` is derived from the recurrence rule, never from the clock,
  /// so two instances computing the same occurrence compute the same instant
  /// and the second insert violates this constraint instead of starting a
  /// second scan. Manual runs use their own trigger instant, so pressing "Run
  /// now" twice in the same millisecond is the only way to collide — and that
  /// collision is also correctly rejected.
  @@unique([scheduleId, scheduledFor])
  /// Execution history for one schedule, newest first.
  @@index([scheduleId, scheduledFor])
  /// Reconciliation sweep: executions left non-terminal by a crash.
  @@index([status])
  @@map("schedule_executions")
}

model AssessmentConfig {
  id           String     @id @default(cuid())
  assessmentId String     @unique
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  // Execution mode controls which plugins run
  executionMode   String       @default("all") // "all" | "profile" | "manual"
  scanProfileId   String?
  scanProfile     ScanProfile? @relation(fields: [scanProfileId], references: [id], onDelete: SetNull)
  manualPlugins   Json         @default("[]") // plugin IDs for mode="manual"
  resolvedPlugins Json         @default("[]") // immutable effective plugin selection for this run

  // These settings always apply regardless of mode
  enableAiAnalysis       Boolean @default(true)
  maxRequestsPerEndpoint Int     @default(10)
  requestDelayMs         Int     @default(200)
  timeoutMs              Int     @default(10000)

  createdAt DateTime @default(now())

  @@map("assessment_configs")
}

model AssessmentSummary {
  id           String     @id @default(cuid())
  assessmentId String     @unique
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  totalEndpoints  Int @default(0)
  testedEndpoints Int @default(0)
  totalFindings   Int @default(0)
  criticalCount   Int @default(0)
  highCount       Int @default(0)
  mediumCount     Int @default(0)
  lowCount        Int @default(0)
  infoCount       Int @default(0)

  /// Immutable snapshot of the score at scan time, 0-100.
  ///
  /// NULLABLE AND WITHOUT A DEFAULT, deliberately. The previous `@default(100)`
  /// was the root cause of failed scans reporting a perfect score: the summary
  /// row was created before plugins ran, and the failure path never updated it,
  /// leaving a persisted 100. `null` now means "no score", and a real 0 stays 0.
  ///
  /// A score is only meaningful together with `scoreStatus`.
  securityScore    Float?
  /// UNAVAILABLE ⇒ securityScore MUST be null. Only FINAL may show 100.
  scoreStatus      ScoreStatus @default(UNAVAILABLE)
  /// Formula version that produced the score, e.g. "score-v1". Lets a future
  /// formula coexist without silently reinterpreting historical numbers.
  scoreVersion     String?
  scoreComputedAt  DateTime?
  /// Human-readable breakdown of what drove the score (severity contributions,
  /// exposure multipliers, coverage), so the number is explainable in the UI.
  scoreExplanation Json?

  riskLevel String @default("LOW") // LOW | MEDIUM | HIGH | CRITICAL

  // ── Execution scope ────────────────────────────────────────────────────────
  // Kept separate from the score: coverage answers "how much did we look at?",
  // the score answers "how bad is what we found?". Conflating them is what made
  // the old OWASP "coverage" chart meaningless (it counted findings).
  //
  // In score-v1 these are counted in PLUGIN executions, the most granular unit
  // the scanner records today. Per-endpoint and per-rule execution tracking does
  // not exist yet, so coveragePercent must not be presented as endpoint or rule
  // coverage.
  plannedChecks    Int    @default(0)
  successfulChecks Int    @default(0)
  failedChecks     Int    @default(0)
  skippedChecks    Int    @default(0)
  executionErrors  Int    @default(0)
  /// successfulChecks / plannedChecks × 100. Null when nothing was planned.
  coveragePercent  Float?

  /// MISNOMER, kept for compatibility: this is a COUNT OF FINDINGS per OWASP
  /// category, not a coverage measure. A category with no security check behind
  /// it stores 0 here, exactly like a category that was tested and came back
  /// clean — which is why the dashboard radar built on this field made
  /// untested categories look secure. Real coverage comes from the check
  /// registry (`GET /plugins/owasp-coverage`). Renaming the column would
  /// rewrite historical scan summaries, so the name stays and every consumer
  /// treats it as finding counts.
  owaspCoverage Json? // findings per OWASP category (see note above)
  pluginResults Json? // PluginExecutionPlan — available / executed / skipped / versions / durationMs / findingCounts
  aiStatus      Json? // AiAnalysisMeta — provider / model / available / analyzed / skipped / durationMs / tokensUsed / reason

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("assessment_summaries")
}

model AssessmentLog {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  level     String // info | warn | error
  plugin    String?
  message   String
  metadata  Json?
  timestamp DateTime @default(now())

  /// Scan detail loads this scan's logs in timestamp order.
  @@index([assessmentId, timestamp])
  @@map("assessment_logs")
}

// Finding and FindingStatus were removed in Phase 1C.6, after every consumer
// was migrated to SecurityIssue + FindingOccurrence. The model conflated a
// per-scan detection with cross-scan triage state, so the same vulnerability
// was re-inserted as a fresh OPEN row on every scan and deleting a scan
// cascaded away the triage attached to it.

// =============================================================================
// PERSISTENT VULNERABILITY DOMAIN
//
// Replaces the single `Finding` model, which conflated two different lifetimes
// in one row: per-scan detection data (evidence, request/response, assessmentId)
// and cross-scan triage state (status, notes). That conflation meant the same
// vulnerability was re-inserted on every scan as a fresh OPEN row, and deleting
// a scan cascaded away the triage work attached to it.
//
//   SecurityIssue     — the vulnerability. Persistent, owned by the PROJECT.
//   FindingOccurrence — one detection of it by one scan. Immutable.
//   IssueStatusChange — auditable history of triage decisions.
//
// `Finding` still exists during Phase 1A so this change is purely additive.
// Phase 1B removes it.
// =============================================================================

/// A vulnerability that persists across scans, identified by a fingerprint.
///
/// Hangs off Project, never off Assessment: deleting a scan must not be able to
/// erase a vulnerability or the triage decisions made about it.
model SecurityIssue {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // ── Identity ───────────────────────────────────────────────────────────────
  //
  // fingerprint = SHA-256 of the canonical string
  //   v1|projectId|pluginId|ruleId|METHOD|normalizedRoute|component
  //
  // The inputs are stored alongside the hash so identity stays explainable and
  // recomputable, and so a future v2 formula can be backfilled by comparison.
  // Deliberately excluded from the hash: title, description, severity, evidence,
  // AI output, timestamps, occurrence ids — anything that may change wording or
  // scoring without changing which vulnerability is being described.
  fingerprint        String
  fingerprintVersion String @default("v1")

  pluginId        String
  ruleId          String
  /// Uppercase HTTP method, or "GLOBAL" for project-wide issues.
  method          String
  /// Template path (`/users/{id}`), never a concrete path. "/" when GLOBAL.
  normalizedRoute String
  /// Stable identifier of the affected area: "endpoint", "header:authorization",
  /// "query:user_id", "path:param", "body:password", "response:content-type",
  /// or "project" for project-wide issues.
  component       String

  // ── Current presentation ───────────────────────────────────────────────────
  // Mutable: refreshed from the newest occurrence. Rewording a check's message
  // must never change issue identity, so none of this feeds the fingerprint.
  title         String
  description   String
  severity      Severity
  owaspCategory String
  cweId         String?
  cvssScore     Float?
  cvssVector    String?

  // ── Triage ─────────────────────────────────────────────────────────────────
  status IssueStatus @default(OPEN)
  notes  String?

  assigneeId String?
  assignee   User?   @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  /// When an ACCEPTED_RISK acceptance lapses. On expiry the issue returns to OPEN.
  acceptedRiskUntil DateTime?

  // ── Lifecycle ──────────────────────────────────────────────────────────────
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  resolvedAt      DateTime?
  reopenedAt      DateTime?
  reopenCount     Int       @default(0)
  occurrenceCount Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  occurrences   FindingOccurrence[]
  statusChanges IssueStatusChange[]
  guidance      IssueGuidance?

  /// The core deduplication guarantee: one logical vulnerability per project per
  /// fingerprint formula. A rescan finds this row instead of inserting a duplicate.
  /// Versioned so introducing a v2 formula cannot silently collide with v1 rows.
  @@unique([projectId, fingerprintVersion, fingerprint])
  /// Issues list filtered by status; project posture counts open/confirmed issues.
  @@index([projectId, status])
  /// Issues list filtered/sorted by severity; posture weights issues by severity.
  @@index([projectId, severity])
  /// "Recently seen" ordering on the project Issues tab and staleness checks.
  @@index([projectId, lastSeenAt])
  /// "Issues assigned to me".
  @@index([assigneeId])
  /// Detection-coverage and per-check reporting within a project.
  @@index([projectId, pluginId])
  /// Sweep for lapsed risk acceptances that must return to OPEN.
  @@index([status, acceptedRiskUntil])
  @@map("security_issues")
}

/// One immutable detection of a SecurityIssue by one assessment.
///
/// Carries `*Snapshot` copies of everything a report needs, so historical
/// reports stay accurate even after the spec is re-imported (which deletes and
/// recreates every Endpoint row), a check is reworded, or a severity is retuned.
model FindingOccurrence {
  id           String        @id @default(cuid())
  issueId      String
  issue        SecurityIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  assessmentId String
  assessment   Assessment    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  /// Best-effort link to the endpoint. SetNull because re-importing a spec
  /// recreates endpoints with new ids; the snapshots below are the durable record.
  endpointId String?
  endpoint   Endpoint? @relation(fields: [endpointId], references: [id], onDelete: SetNull)

  /// Deterministic idempotency token: SHA-256 of `fingerprintVersion|fingerprint`.
  ///
  /// Derived purely from issue identity, so the worker can compute it before any
  /// row exists and persist with skipDuplicates. Combined with the unique
  /// constraint below, a BullMQ retry of a partially-completed job re-inserts
  /// nothing instead of duplicating detections. Never derived from time,
  /// randomness or row ids.
  occurrenceKey String

  // ── Immutable snapshots ────────────────────────────────────────────────────
  methodSnapshot        String
  pathSnapshot          String
  operationIdSnapshot   String?
  pluginIdSnapshot      String
  pluginVersionSnapshot String
  ruleIdSnapshot        String
  severitySnapshot      Severity
  cvssSnapshot          Float?
  owaspSnapshot         String
  cweSnapshot           String?
  titleSnapshot         String
  descriptionSnapshot   String
  impactSnapshot        String?
  remediationSnapshot   String?

  // ── Evidence (redacted before persistence — see common/utils/redact.util) ──
  evidence     Json?
  httpRequest  String?
  httpResponse String?
  affectedUrl  String?
  /// The affected component for this detection; mirrors SecurityIssue.component.
  location     String

  validation OccurrenceValidation @default(UNVERIFIED)

  // ── Provenance ─────────────────────────────────────────────────────────────
  /// Hash of the effective scan configuration, so a result can be tied to the
  /// exact settings that produced it.
  assessmentConfigHash String?
  specVersionSnapshot  String?

  detectedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  /// Idempotency guarantee. Because occurrenceKey is a pure function of issue
  /// identity, this enforces "at most one detection of a given vulnerability per
  /// scan" and makes worker retries safe at the database level rather than
  /// relying on in-memory bookkeeping.
  @@unique([assessmentId, occurrenceKey])
  /// Occurrence history on the issue detail page, newest first.
  @@index([issueId, detectedAt])
  /// "Findings from this scan" on the scan detail page.
  @@index([assessmentId])
  /// "Issues affecting this endpoint" on the project Endpoints tab.
  @@index([endpointId])
  @@map("finding_occurrences")
}

/// Auditable history of every triage transition on an issue.
///
/// Written on every status change, including automatic ones (reopen on
/// recurrence, expiry of an accepted risk). `SecurityIssue.status` is the
/// current value; this table is why it holds that value.
model IssueStatusChange {
  id      String        @id @default(cuid())
  issueId String
  issue   SecurityIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  /// Null on the initial transition into OPEN when the issue is created.
  fromStatus IssueStatus?
  toStatus   IssueStatus

  /// Null when the change was made by the system rather than a person.
  actorId String?
  actor   User?   @relation("IssueStatusActor", fields: [actorId], references: [id], onDelete: SetNull)

  /// The scan that triggered an automatic change, when applicable.
  ///
  /// SetNull — deleting a scan must never destroy triage history. This is the
  /// specific cascade that made the old model lose triage work.
  assessmentId String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  /// Required by the UI for FALSE_POSITIVE, ACCEPTED_RISK and RESOLVED.
  reason String?

  /// True when the system made the change (recurrence reopen, acceptance expiry).
  automatic Boolean @default(false)

  /// Expiry recorded at the moment risk was accepted.
  acceptedRiskUntil DateTime?

  createdAt DateTime @default(now())

  /// Activity timeline for one issue, newest first.
  @@index([issueId, createdAt])
  /// "What did this user triage?" for audit review.
  @@index([actorId])
  @@map("issue_status_changes")
}

// =============================================================================
// REPORT
// =============================================================================

/// An issued report artifact.
///
/// A row is created ONLY by an explicit generation (`POST /reports/assessment/
/// :assessmentId/generate`) or by the scanner's automatic post-scan generation.
/// Downloading never creates one: `GET /reports/:id/download` replays the
/// artifact persisted here.
///
/// The artifact is immutable. `sourceSnapshot` freezes the exact document text
/// at issue time, so re-triaging an issue, rewording a check or retuning a
/// severity cannot retroactively change a report that was already delivered.
model Report {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  type   ReportType
  format ReportFormat
  title  String

  /// Why this artifact exists. See ReportKind.
  kind ReportKind @default(MANUAL_EXPORT)

  /// Where generation has got to.
  ///
  /// A row is inserted PENDING by the queue producer and only reaches COMPLETED
  /// once bytes exist, so "the report is ready" is never announced — in the UI
  /// or by email — on the strength of a row that merely exists.
  status ReportStatus @default(COMPLETED)

  /// Why the last generation attempt failed, for a FAILED row. Cleared on a
  /// subsequent success so a recovered report does not still show an error.
  error String?

  /// How many times generation has been attempted. Read by the retry policy and
  /// shown on the report detail so a flaky renderer is visible rather than
  /// merely slow.
  attempts Int @default(0)

  /// Who the artifact belongs to — the operator who asked for it, or the owner
  /// of the project for an automatic one. Nullable because pre-existing rows
  /// predate the column; resolved through the assessment when absent.
  requestedById String?
  requestedBy   User?   @relation("ReportRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  /// The idempotency guard for automatic reports: holds `assessmentId` on the
  /// one automatic report of that scan, and NULL on every manual export.
  ///
  /// Postgres treats NULLs as distinct in a unique index, so manual exports are
  /// unconstrained while a second automatic report for the same assessment
  /// cannot be inserted at all — a redelivered `scan.completed` collides here
  /// instead of producing a duplicate PDF.
  autoKey String? @unique

  /// Explicit revision of (assessment, type, format). Starts at 1; only a
  /// deliberate "Regenerate" mints version + 1. Downloads never bump it.
  version Int @default(1)

  /// Server-derived file name served on download. Never client-supplied.
  fileName String?
  /// Relative name inside the report storage root — `<id>.<ext>`, no directory
  /// component, so it cannot escape the root. Binary formats (PDF) only.
  filePath String?
  fileSize Int?
  /// SHA-256 of the delivered bytes, used to detect a corrupted/stale artifact.
  checksum String?

  /// The frozen document source this artifact was rendered from: the file
  /// itself for HTML/MARKDOWN/JSON/SARIF, and the HTML a PDF was printed from.
  /// Lets a lost binary be re-rendered byte-for-byte without re-reading findings.
  sourceSnapshot   String?
  /// Version of the generator that produced the artifact, shown on report detail.
  generatorVersion String?

  generatedAt DateTime @default(now())

  /// The duplicate guard. Two concurrent generations of the same artifact
  /// collide here instead of both inserting; the loser returns the winner's row.
  @@unique([assessmentId, type, format, version])
  /// Reports of one scan (reports list grouping, scan detail → Reports).
  @@index([assessmentId])
  /// The reports queue asks "what is still generating?" and the UI asks "did
  /// anything fail?"; both filter on status before anything else.
  @@index([status])
  @@map("reports")
}

/// One attempted email, recorded whether or not it was sent.
///
/// Exists to make delivery idempotent. Jobs retry and events can be redelivered,
/// so "send the report-ready email" must be safe to ask for repeatedly — the
/// unique `idempotencyKey` turns the second ask into a no-op instead of a second
/// message in the recipient's inbox.
///
/// Deliberately NOT merged into Notification: a notification is something the
/// user reads in the product, this is a record of an outbound message to a third
/// party. They have different lifetimes, different privacy properties, and one
/// notification can exist with no email and vice versa.
model EmailDelivery {
  id String @id @default(cuid())

  /// `<event>:<entityId>:<userId>` — stable across retries of the same logical
  /// send, distinct for genuinely different ones.
  idempotencyKey String @unique

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Recorded rather than joined through `user`: an address that changes later
  /// must not rewrite the history of where a message was actually delivered.
  toEmail  String
  subject  String
  /// Which template rendered it, e.g. `report-ready`.
  template String

  status   EmailDeliveryStatus @default(PENDING)
  attempts Int                 @default(0)

  /// Resend's id for the accepted message, for support requests and for
  /// correlating with the provider's own delivery log.
  providerMessageId String?
  /// Why it failed or was skipped. Never contains credentials.
  failureReason     String?

  /// What the message was about, so a report's delivery history is reachable
  /// from the report itself.
  entityType String?
  entityId   String?

  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// "Has this already been sent?" on the retry path.
  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@map("email_deliveries")
}

// =============================================================================
// PLUGIN MANAGEMENT
// =============================================================================

model Plugin {
  id                 String         @id // stable slug: "bola", "jwt-analysis"
  name               String
  version            String         @default("1.0.0")
  description        String
  longDescription    String?
  author             String         @default("API Analyser Core Team")
  category           PluginCategory
  owaspMappings      Json           @default("[]")
  cweIds             Json           @default("[]")
  tags               Json           @default("[]")
  isBuiltin          Boolean        @default(true)
  isEnabled          Boolean        @default(true) // global default
  configSchema       Json? // JSON Schema for config UI
  defaultConfig      Json?
  permissions        Json           @default("[]")
  documentationUrl   String?
  changelog          String?
  minimumCoreVersion String         @default("1.0.0")
  license            String         @default("MIT")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userConfigs PluginUserConfig[]
  executions  PluginExecution[]

  @@map("plugins")
}

model PluginUserConfig {
  id        String  @id @default(cuid())
  pluginId  String
  userId    String
  isEnabled Boolean @default(true)
  config    Json? // user overrides for configSchema fields

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plugin Plugin @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pluginId, userId])
  @@map("plugin_user_configs")
}

model PluginExecution {
  id            String                @id @default(cuid())
  pluginId      String
  assessmentId  String?
  userId        String
  status        PluginExecutionStatus
  startedAt     DateTime
  completedAt   DateTime?
  durationMs    Int?
  findingsCount Int                   @default(0)
  errorMessage  String?
  metadata      Json?

  createdAt DateTime @default(now())

  plugin     Plugin      @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  assessment Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  /// Execution history for one check (plugins/:id/executions), newest first.
  @@index([pluginId, startedAt])
  /// Which checks actually ran in a scan — the basis for scope-aware comparison.
  @@index([assessmentId])
  @@map("plugin_executions")
}

model ScanProfile {
  id             String  @id @default(cuid())
  name           String
  description    String?
  icon           String?
  userId         String? // null = system profile
  isSystem       Boolean @default(false)
  enabledPlugins Json    @default("[]") // array of plugin IDs
  pluginConfigs  Json? // per-plugin config overrides

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessmentConfigs AssessmentConfig[]
  scheduledScans    ScheduledScan[]

  @@map("scan_profiles")
}

// =============================================================================
// AI CONFIGURATION
// =============================================================================

/// One row per AI provider. Only one row has isActive=true at a time.
/// API keys stored AES-256-CBC encrypted (iv_hex:ciphertext_hex).
model AiProviderConfig {
  id               String    @id @default(cuid())
  provider         String    @unique // openai | grok | claude | gemini | ollama
  model            String?
  apiKey           String? // encrypted
  baseUrl          String? // Ollama / custom
  isActive         Boolean   @default(false)
  profile          String    @default("balanced")
  analyzeCritical  Boolean   @default(true)
  analyzeHigh      Boolean   @default(true)
  analyzeMedium    Boolean   @default(false)
  analyzeLow       Boolean   @default(false)
  executiveSummary Boolean   @default(true)
  maxTokens        Int?
  temperature      Float?
  timeoutMs        Int?
  maxFindings      Int?
  retryAttempts    Int       @default(2)
  lastTestedAt     DateTime?
  lastTestSuccess  Boolean?
  lastTestMessage  String?
  configuredAt     DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("ai_provider_configs")
}

// =============================================================================
// AUDIT LOG
// =============================================================================

/// One recorded event, whether an operator did it or the system did.
///
/// This is both the audit trail and the application log. They were kept as one
/// table on purpose: an investigator asking "what happened around 12:44?" wants
/// the failed login, the worker crash and the settings change interleaved on a
/// single timeline, and two tables make that a client-side merge that no index
/// can help with.
///
/// Almost every column is nullable because the events are genuinely different
/// shapes — an HTTP request has a route and a duration, a worker error has a
/// stack trace and neither. Writing a placeholder into a column that does not
/// apply would make "unknown" and "not applicable" indistinguishable.
///
/// Retention deletes from this table in batches; see LogRetentionService.
model AuditLog {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // ── Classification ─────────────────────────────────────────────────────────
  /// Dotted event name, e.g. `auth.login.failed`, `scan.completed`. The primary
  /// identity of an event; `action` below is the coarse CRUD verb kept for the
  /// rows written before this column existed.
  event    String
  severity LogSeverity  @default(INFO)
  category LogCategory  @default(SYSTEM)
  status   LogStatus    @default(SUCCESS)
  /// Coarse verb. Nullable: system and worker events are not CRUD operations,
  /// and forcing one of these onto them would be a lie in the data.
  action   AuditAction?

  // ── Subject ────────────────────────────────────────────────────────────────
  resource   String
  resourceId String?
  /// Human-readable one-line description, rendered as the event's title.
  message    String?

  // ── Actor ──────────────────────────────────────────────────────────────────
  ipAddress String?
  userAgent String?
  /// Where the event was produced, e.g. `api`, `scanner-worker`, `retention`.
  source    String?

  // ── Request context ────────────────────────────────────────────────────────
  httpMethod String?
  route      String?
  statusCode Int?
  /// Correlation id shared by every event from one request or one job, so a
  /// failure can be traced across API → worker → scan → report.
  requestId  String?
  durationMs Int?

  // ── Related records ────────────────────────────────────────────────────────
  // Plain ids, not relations, on purpose: a log entry must survive the deletion
  // of the thing it describes. A foreign key would either cascade the evidence
  // away or block the delete.
  projectId    String?
  assessmentId String?
  reportId     String?

  // ── Payload ────────────────────────────────────────────────────────────────
  /// Sanitised through redactObject before it is written. Never contains
  /// credentials — see AuditService.sanitize.
  metadata   Json?
  errorCode  String?
  stackTrace String?

  /// Retained for the rows written before `status` existed. New writers set
  /// both; readers should prefer `status`.
  success Boolean @default(true)

  createdAt DateTime @default(now())

  /// Default view and every retention delete: newest first, paginated.
  @@index([createdAt])
  /// "What did this user do?"
  @@index([userId, createdAt])
  /// The severity filter, which is the most-used one in an incident.
  @@index([severity, createdAt])
  /// The category filter.
  @@index([category, createdAt])
  /// "Show me every occurrence of this event."
  @@index([event, createdAt])
  /// Correlation-id lookup: trace one request across subsystems.
  @@index([requestId])
  /// Everything that happened during one scan.
  @@index([assessmentId])
  @@map("audit_logs")
}

/// An in-app message addressed to one user.
///
/// Written by NotificationsService in reaction to domain events, never by a
/// module calling it directly — see NotificationsListener. Rows are per-user so
/// "read" is a property of the recipient, not of the underlying event: two
/// admins are notified of the same failed scan and dismiss it independently.
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     NotificationType
  category NotificationCategory
  severity LogSeverity          @default(INFO)

  title   String
  message String

  /// What the notification is about, e.g. `assessment`, `report`, `project`.
  /// A plain id like AuditLog's: the notification outlives its subject.
  entityType String?
  entityId   String?
  /// In-app path the "open" action navigates to. Stored rather than derived so
  /// a route change cannot silently break historical notifications.
  href       String?

  read   Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  /// The notification list and the unread badge, both scoped to one user.
  @@index([userId, read, createdAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// Per-user delivery preferences, one row per user.
///
/// Absence of a row means "never configured" and is treated as all-defaults by
/// NotificationPreferencesService, so a new user is not silently opted out of
/// everything by having no row.
model NotificationPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  scanCompleted   Boolean @default(true)
  scanFailed      Boolean @default(true)
  reportGenerated Boolean @default(true)
  reportFailed    Boolean @default(true)
  securityWarning Boolean @default(true)
  criticalFinding Boolean @default(true)
  newFindings     Boolean @default(true)
  systemError     Boolean @default(true)

  /// The master switch for outbound email. Off by default: a self-hosted
  /// install has no mail provider configured until someone sets one up, and
  /// defaulting this on would queue deliveries that can only fail.
  emailEnabled Boolean @default(false)

  /// Per-event email switches, each subordinate to `emailEnabled`.
  ///
  /// A deliberately smaller set than the in-app switches above. Email is
  /// interruptive and cannot be marked read, so only the events worth someone's
  /// attention while they are elsewhere are offered: an outcome they are waiting
  /// for, a failure that stops work, and a critical vulnerability. Routine
  /// findings stay in-app.
  emailScanCompleted   Boolean @default(true)
  emailScanFailed      Boolean @default(true)
  emailReportGenerated Boolean @default(true)
  emailCriticalFinding Boolean @default(true)

  /// The weekly activity digest.
  ///
  /// Its own switch rather than riding on `emailScanCompleted`, because it is a
  /// different kind of message: the others are reactions to something the user
  /// caused, this one arrives on a schedule whether or not they did anything.
  /// Someone who wants to know the moment a scan finishes may reasonably not
  /// want a Monday digest, and vice versa.
  ///
  /// Still subordinate to `emailEnabled`, like every switch above it.
  emailWeeklySummary Boolean @default(true)

  /// Play a short sound on arrival. Browser autoplay policy still applies; the
  /// UI never tries to work around it.
  soundEnabled   Boolean @default(false)
  /// Web Notifications API. Requires an OS-level permission grant the user
  /// gives separately, so this being true does not guarantee delivery.
  desktopEnabled Boolean @default(false)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("notification_preferences")
}

/// Runtime configuration an administrator can change without a redeploy.
///
/// Resolution order is DB → environment → application default (see
/// SettingsService). A key is absent here until someone overrides it, so
/// deleting a row restores the environment's value rather than nulling the
/// setting — which is what makes "reset to default" possible at all.
model SystemSetting {
  key   String @id
  /// Wrapped as `{ "value": ... }` so booleans, numbers and strings share one
  /// column without a discriminator.
  value Json

  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("system_settings")
}

/// AI-generated remediation guidance for one issue.
///
/// Separate from SecurityIssue on purpose. Scanner evidence and AI advice must
/// never share a row: the scanner's findings are authoritative and immutable,
/// while guidance is advisory, regenerable, and may fail or be disabled
/// entirely. A failed enrichment writes a row with status FAILED and no
/// payload, so "we tried and could not" is distinguishable from "never tried".
///
/// One row per issue (guidance replaces its predecessor rather than
/// accumulating): the metadata below records which prompt and knowledge pack
/// produced the current answer, which is what makes it auditable.
model IssueGuidance {
  id      String        @id @default(cuid())
  issueId String        @unique
  issue   SecurityIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  status    GuidanceStatus
  /// Validated SecurityGuidance payload. Null unless status is READY.
  payload   Json?
  /// Machine-readable failure cause, e.g. NOT_JSON, RATE_LIMITED, TIMEOUT.
  errorCode String?

  // ── Reproducibility ────────────────────────────────────────────────────────
  /// Shape of the payload, e.g. `guidance-v1`.
  schemaVersion    String
  /// Prompt that produced it, e.g. `guidance-prompt-v3`.
  promptVersion    String
  /// Knowledge pack consulted, e.g. `knowledge-2026.08.1`.
  knowledgeVersion String
  /// Ids of the playbooks actually retrieved for this finding.
  playbookIds      Json   @default("[]")

  // ── Provenance ─────────────────────────────────────────────────────────────
  provider   String
  model      String
  /// Model's self-reported confidence, 0–1. Null when it did not give one.
  confidence Float?

  // ── Cost accounting ────────────────────────────────────────────────────────
  tokensInput  Int   @default(0)
  tokensOutput Int   @default(0)
  /// Estimated, not billed. Always labelled as an estimate in the UI.
  costUsd      Float @default(0)

  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// "Show me everything a given provider produced" and usage roll-ups.
  @@index([provider, generatedAt])
  @@index([status])
  @@map("issue_guidance")
}

enum GuidanceStatus {
  READY
  FAILED
  /// The provider is configured but analysis was not requested for this scan.
  SKIPPED
}
