# =============================================================================
# API Analyser — Environment Configuration
#
# Copy to .env and fill in real values:
#     cp .env.example .env
#
# The API validates the security-critical variables at startup and REFUSES TO
# BOOT if any is missing, too short, or still a placeholder. There are no
# hardcoded fallbacks — a secret committed to a repository is a public secret.
#
# Generate every secret below with:
#     openssl rand -hex 32
# =============================================================================

# ── REQUIRED — application will not start without these ──────────────────────

# PostgreSQL connection string.
DATABASE_URL=postgresql://api_analyser:api_analyser_dev_password@localhost:5432/api_analyser

# Signs access tokens. Minimum 32 characters. NEVER reuse across environments.
JWT_SECRET=

# Signs refresh tokens. Minimum 32 characters. MUST differ from JWT_SECRET.
REFRESH_TOKEN_SECRET=

# Encrypts stored credentials (project auth configs, AI provider API keys)
# with AES-256-GCM.
#
# EXACT FORMAT — 64 hexadecimal characters (32 bytes), optional "hex:" prefix:
#     ENCRYPTION_KEY=<64 hex chars>
#     ENCRYPTION_KEY=hex:<64 hex chars>
#
# Generate with:
#     openssl rand -hex 32
#
# Anything else is rejected at startup. The key is never padded, truncated or
# re-encoded: a value that does not match this contract is an error, not
# something the application silently coerces into a key.
#
# WARNING: changing this makes every previously stored credential undecryptable.
# They must then be re-entered. Back it up alongside your database.
ENCRYPTION_KEY=

# ── Core services ────────────────────────────────────────────────────────────

REDIS_URL=redis://:api_analyser_dev_password@localhost:6379

# The port the API process binds. Read directly by the API; API_PORT below is
# the HOST port docker-compose publishes in front of it, which is why the two
# are separate — inside a container the process always listens on 4000.
PORT=4000

API_PORT=4000
WEB_PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# CORS allowlist for /api/v1/*, /api/auth/* and Better Auth's own
# trustedOrigins — all three read this the same way (see cors.util.ts).
#
# Comma-separated, no spaces required around the commas. Only set this when
# more than one frontend legitimately needs credentialed access to this API
# (an app subdomain plus a staging environment, say); a single-origin install
# needs nothing here, because FRONTEND_URL above is used as the allowlist when
# this is unset. An Origin that is not on this list gets no CORS headers at
# all — never a wildcard, never the request's own Origin reflected back
# unconditionally, since this API uses `credentials: true`.
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com

JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# Interactive API documentation:
#     Swagger UI     http://localhost:4000/api/docs
#     OpenAPI JSON   http://localhost:4000/api/docs-json
#     OpenAPI YAML   http://localhost:4000/api/docs-yaml
#
# On unless this is set to `false`, and independent of NODE_ENV on purpose —
# `docker compose up` runs the production build, and the docs should still be
# there. Turn it off on an install that is reachable from the internet if you
# would rather not publish the API surface. The routes it documents all require
# a bearer token either way.
SWAGGER_ENABLED=true

# ── Docker Compose (used by docker-compose.yml) ──────────────────────────────

POSTGRES_USER=api_analyser
POSTGRES_PASSWORD=api_analyser_dev_password
POSTGRES_DB=api_analyser
POSTGRES_PORT=5432
REDIS_PASSWORD=api_analyser_dev_password
REDIS_PORT=6379

# ── Better Auth ──────────────────────────────────────────────────────────────

# Minimum 32 characters.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000

# The administrator created on the FIRST boot only, while the user table is
# still empty. Set these before you start the stack for the first time; changing
# them later has no effect, and changing the password in the UI is not undone by
# a restart. There is no OAuth and no sign-up-from-nothing: this admin creates
# every other account.
ADMIN_EMAIL=admin@apianalyser.local
ADMIN_PASSWORD=admin1234

# ── Scanner ──────────────────────────────────────────────────────────────────

MAX_CONCURRENT_SCANS=3
SCAN_TIMEOUT_MS=300000
MAX_REQUESTS_PER_ENDPOINT=10
RATE_LIMIT_TEST_REQUESTS=25
REQUEST_DELAY_MS=100

# Where generated report artifacts (PDFs) are stored, relative to the API's
# working directory or absolute. Text formats live in the database with the
# report, so only binary artifacts land here. Files are named after the report
# id — nothing from a request ever reaches this path. Safe to delete: a missing
# file is re-rendered from the snapshot frozen with its report.
#
# Every scan that completes gets a PDF here automatically — it is generated on
# the `reports` queue, not by the scan worker, and retried three times with
# backoff before the report is marked FAILED. Other formats (JSON, HTML,
# Markdown, SARIF) are still produced only when somebody asks for them.
REPORTS_DIR=./reports

# PDF rendering uses a headless Chromium. Leave this blank and the API looks for
# an installed Chrome, Edge or Chromium in the usual locations for the platform;
# set it when yours lives somewhere else, or when there is none to find. Only
# the PDF format needs it — every other format renders without a browser.
#
# With Docker there is nothing to do: the api image installs Chromium and points
# at it. From source, install Chrome or Chromium — without one, PDF is the only
# format that fails, at generation and again at download.
CHROMIUM_EXECUTABLE_PATH=

# Drops the Chromium sandbox. Leave BLANK.
#
# Blank means "sandbox on", which is right for a from-source run: a desktop OS
# grants the kernel namespaces the sandbox is built from. docker-compose.yml
# sets this to true for the container, where Docker's default seccomp profile
# denies those namespaces and a sandboxed Chromium cannot start at all. Setting
# it to true here as well would carry that concession onto hosts that never
# needed it — the sandbox is what contains the renderer, and report HTML is
# built from scan data.
CHROMIUM_DISABLE_SANDBOX=

# SSRF policy for the URLs the API fetches on a user's behalf — today that is
# OpenAPI specification imports.
#
# true (default): private, loopback, link-local and reserved ranges are allowed,
#   because the usual install is somebody scanning their own API on their own
#   network — a tool that cannot read a spec from http://localhost:8080 is
#   useless to them.
# false: those ranges are blocked, which also blocks internal services and cloud
#   metadata endpoints (169.254.169.254). Set this on any deployment where the
#   person entering a URL is not the person who owns the network the API runs on.
#
# This is the environment default only. An administrator can flip it at runtime
# in Settings → Configuration → Scanner, and that override wins; resetting it
# there restores this value.
ALLOW_PRIVATE_TARGETS=true

# Set to true when the API runs inside Docker and must reach the host via
# host.docker.internal instead of localhost.
DOCKER_ENV=false

# ── Logs & observability ─────────────────────────────────────────────────────
#
# Every variable in this block is a DEFAULT, not a fixed value. An administrator
# can override each one at runtime from Settings → Audit logs → Log management,
# which stores the override in the database; the effective value is resolved as
# database → environment → built-in default. Deleting the override in the UI
# restores the value set here, which is what "reset to default" means.
#
# Nothing in the application ever writes back to this file.

# Capture routine application events.
#
# Authentication, security and configuration events — and anything at ERROR or
# above — are recorded regardless of this setting. An administrator must not be
# able to switch off their own audit trail, so this is a volume control for
# routine noise, not a way to stop being audited.
LOG_COLLECTION_ENABLED=true

# Allow administrators to subscribe to the real-time event stream (SSE) used by
# the Live events viewer. Turning it off does not stop events being recorded.
LOG_LIVE_STREAM_ENABLED=true

# Delete events that exceed the policy below, on a schedule. Runs as a BullMQ
# repeatable job, so it executes once across the whole deployment rather than
# once per API replica.
LOG_RETENTION_ENABLED=true

# Events older than this many days are deleted by the cleanup job.
LOG_RETENTION_DAYS=30

# Hard ceiling on the events table. When exceeded, the oldest events are deleted
# first. Deletes run in batches so a large cleanup cannot lock the table.
LOG_MAX_RECORDS=500000

# How often the retention job runs, in hours.
LOG_CLEANUP_INTERVAL_HOURS=24

# ── Notifications ────────────────────────────────────────────────────────────
#
# In-app notifications. Independent of the Email block above: these are always
# available, work with no mail transport configured, and are never replaced by
# an email. There are no webhooks.

# Master switch. When false, no notification is created for any user regardless
# of their individual preferences under Settings → Notifications.
NOTIFICATIONS_ENABLED=true

# Read notifications older than this many days are removed by the same cleanup
# job as the logs. Unread notifications are kept whatever their age.
NOTIFICATIONS_RETENTION_DAYS=90

# ── AI enrichment (optional) ─────────────────────────────────────────────────
#
# AI is a post-processor: it enriches findings but never creates, re-scores or
# resolves them. A scan completes normally when AI is unavailable. Everything
# below is optional — leave it blank and the app runs fine without it.
#
# Recommended: configure providers from the UI instead (Settings → AI
# Configuration, admin only). Keys saved there are encrypted at rest, can be
# switched/tested without a restart, and take priority over these env vars
# whenever both are set. Use the env vars below only for a key you want baked
# into the deployment itself (e.g. a shared default for every install).
#
# Provider: openai | grok | claude | gemini | ollama | none
AI_PROVIDER=none

# Every provider takes the same eight tuning variables under its own prefix, and
# each one is shown at its built-in default below — set only what you want to
# differ. The four ANALYZE_* switches decide which severities are sent for
# enrichment: CRITICAL and HIGH are on, MEDIUM and LOW are off, because those
# two are where the volume is and enrichment costs a request each.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.3
OPENAI_TIMEOUT=30000
OPENAI_MAX_FINDINGS=10
OPENAI_ANALYZE_CRITICAL=true
OPENAI_ANALYZE_HIGH=true
OPENAI_ANALYZE_MEDIUM=false
OPENAI_ANALYZE_LOW=false
OPENAI_EXECUTIVE_SUMMARY=true

# Groq. Note the prefix is GROQ_ while AI_PROVIDER spells it `grok`.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_MAX_TOKENS=2000
# GROQ_TEMPERATURE=0.3
# GROQ_TIMEOUT=30000
# GROQ_MAX_FINDINGS=10
# GROQ_ANALYZE_CRITICAL=true
# GROQ_ANALYZE_HIGH=true
# GROQ_ANALYZE_MEDIUM=false
# GROQ_ANALYZE_LOW=false
# GROQ_EXECUTIVE_SUMMARY=true

# Anthropic Claude.
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
# CLAUDE_MAX_TOKENS=2000
# CLAUDE_TEMPERATURE=0.3
# CLAUDE_TIMEOUT=30000
# CLAUDE_MAX_FINDINGS=10
# CLAUDE_ANALYZE_CRITICAL=true
# CLAUDE_ANALYZE_HIGH=true
# CLAUDE_ANALYZE_MEDIUM=false
# CLAUDE_ANALYZE_LOW=false
# CLAUDE_EXECUTIVE_SUMMARY=true

# Google Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MAX_TOKENS=2000
# GEMINI_TEMPERATURE=0.3
# GEMINI_TIMEOUT=30000
# GEMINI_MAX_FINDINGS=10
# GEMINI_ANALYZE_CRITICAL=true
# GEMINI_ANALYZE_HIGH=true
# GEMINI_ANALYZE_MEDIUM=false
# GEMINI_ANALYZE_LOW=false
# GEMINI_EXECUTIVE_SUMMARY=true

# Ollama, running locally. No API key: a reachable base URL is the whole
# credential. The timeout is higher and the findings cap lower than the hosted
# providers because local inference is slower per finding.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3
# OLLAMA_MAX_TOKENS=2000
# OLLAMA_TEMPERATURE=0.3
# OLLAMA_TIMEOUT=60000
# OLLAMA_MAX_FINDINGS=5
# OLLAMA_ANALYZE_CRITICAL=true
# OLLAMA_ANALYZE_HIGH=true
# OLLAMA_ANALYZE_MEDIUM=false
# OLLAMA_ANALYZE_LOW=false
# OLLAMA_EXECUTIVE_SUMMARY=true

# ── Frontend (NEXT_PUBLIC_* is exposed to the browser — never put secrets here)

NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME=API Analyser
NEXT_PUBLIC_APP_VERSION=0.2.0
NEXT_PUBLIC_ENABLE_AI=true

# ── Optional integrations ────────────────────────────────────────────────────

# OTEL_EXPORTER_OTLP_ENDPOINT=
# GRAFANA_PASSWORD=

# ── Development seeds (bun run seed:dashboard) ───────────────────────────────
#
# Only read by the demo-data seed script. Nothing in the running application
# consults them.

# Which account the seeded projects and scans are attached to. Defaults to the
# ADMIN_EMAIL account. Re-running with a different address moves the data.
# SEED_DASHBOARD_EMAIL=admin@apianalyser.local

# The seed refuses to run when NODE_ENV=production. This is the override, and
# it exists for demo environments that are deployed like production but are not.
# FORCE_DASHBOARD_SEED=false
