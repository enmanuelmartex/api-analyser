# =============================================================================
# API Analyser mail relay — environment
# =============================================================================
#
# Copy to `.env.local` for development. NEVER put a real value in this file:
# it is the one env file that is committed.
#
# In production these live only in the Vercel project's Environment Variables.
# =============================================================================

# Resend API key. Create it at https://resend.com/api-keys with send-only
# permission on the `notifications.apianalyser.com` domain.
RESEND_API_KEY=

# Shared secret every caller must present as `Authorization: Bearer <token>`.
# Generate one with: openssl rand -base64 48
RELAY_SECRET=

# Verified sender. Falls back to this exact value when unset.
EMAIL_FROM="API Analyzer <reports@notifications.apianalyser.com>"

# Absolute origin the email logo is loaded from. Defaults to this deployment's
# own production domain, because the images live in `public/brand/` and are
# therefore deployed alongside the templates that reference them.
#
# Must be https and absolute: a mail client has no page to resolve a relative
# path against, and most refuse to load http:// at all, so a localhost value
# renders as a broken image in every inbox.
# EMAIL_ASSET_BASE_URL=https://mail.apianalyser.com

# -----------------------------------------------------------------------------
# Optional — distributed rate limiting.
#
# Unset, the relay uses a per-instance in-memory limiter, which is best-effort
# only on serverless (each cold instance gets its own counter). Set both of
# these to an Upstash Redis REST endpoint and the relay switches to a shared
# counter automatically, with no code change. See README → Rate limiting.
# -----------------------------------------------------------------------------
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional — tune the limit (defaults: 20 requests per 60 second window).
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW_SECONDS=60
