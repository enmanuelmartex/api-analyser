# =============================================================================
# API Analyser — .gitignore
# =============================================================================

# Environment variables
.env
.env.local
.env.*.local
!.env.example

# Dependencies
node_modules/
.bun/

# Build outputs
dist/
build/
.next/
# Production build produced alongside a running dev server via NEXT_DIST_DIR
# (see apps/web/next.config.ts) — used for Lighthouse runs, never committed.
.next-prod/
out/

# TypeScript
*.tsbuildinfo
tsconfig.tsbuildinfo

# Prisma
apps/api/prisma/migrations/*.sql.bak

# Reports generated at the repository root. Keep frontend source routes named
# `reports` visible to Git.
/reports/
*.pdf
*.sarif

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun-debug.log*

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Testing
coverage/
.nyc_output/

# Docker
.dockerignore

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Uploads
uploads/

# Generated report artifacts (REPORTS_DIR). Reproducible from the snapshot
# stored with each report, so they are never committed.
storage/
apps/api/reports/

# Secrets
*.pem
*.key
*.p12
*.pfx
secrets/

# Cache
.eslintcache
.tsbuildinfo
.parcel-cache
